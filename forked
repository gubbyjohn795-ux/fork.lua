-- TOGGLE  (row: a small square checkbox on the left, label beside it)
-- ═══════════════════════════════════════════════════════════
function Groupbox:AddToggle(Flag, Options)
    Options = Options or {}
    local holder = Create("Frame", { Size = UDim2.new(1, 0, 0, 20), AutomaticSize = Enum.AutomaticSize.Y, BackgroundTransparency = 1, Parent = self.Body })
    local top = Create("Frame", { Size = UDim2.new(1, 0, 0, 20), BackgroundTransparency = 1, Parent = holder })

    local box = Create("Frame", { AnchorPoint = Vector2.new(0, 0.5), Position = UDim2.fromScale(0, 0.5), Size = UDim2.fromOffset(18, 18), Theme = { BackgroundColor3 = "Element" }, Parent = top })
    Corner(box, 5)
    local stroke = Create("UIStroke", { Thickness = 1, Transparency = 0.3, Theme = { Color = "Divider" }, Parent = box })
    box.ZIndex = 2
    local boxGlow = Library:AddGlow(box, 16, 0.3)
    local check = Create("ImageLabel", { AnchorPoint = Vector2.new(0.5, 0.5), Position = UDim2.fromScale(0.5, 0.5), Size = UDim2.fromOffset(13, 13), BackgroundTransparency = 1, ImageTransparency = 1, Image = Icon("check"), ImageColor3 = Color3.new(1, 1, 1), Parent = box })
    Label({ Position = UDim2.fromOffset(26, 0), Size = UDim2.new(1, -26, 1, 0), Text = Options.Text or Flag, FontFace = FONT.Medium, TextSize = 13, Theme = { TextColor3 = "Text" }, Parent = top })

    if Options.Description then
        local d = AddDesc(holder, Options.Description, 24)
    end

    local Toggle = { Value = Options.Default or false, Type = "Toggle", Callbacks = {} }
    function Toggle:SetValue(v)
        self.Value = v and true or false
        Library.Flags[Flag] = self.Value
        if self.Value then
            Tween(box, { BackgroundColor3 = Library.Theme.Accent }, 0.15)
            Tween(check, { ImageTransparency = 0 }, 0.15)
            stroke.Transparency = 1
            Library:SetGlow(boxGlow, true)
        else
            Tween(box, { BackgroundColor3 = Library.Theme.Element }, 0.15)
            Tween(check, { ImageTransparency = 1 }, 0.15)
            stroke.Transparency = 0.3
            Library:SetGlow(boxGlow, false)
        end
        if Options.Callback then pcall(Options.Callback, self.Value) end
        for _, cb in self.Callbacks do pcall(cb, self.Value) end
    end
    function Toggle:OnChanged(fn) table.insert(self.Callbacks, fn); return self end
    function Toggle:GetState() return self.Value end

    local btn = Create("TextButton", { Size = UDim2.new(1, 0, 1, 0), BackgroundTransparency = 1, Text = "", Parent = top })
    Connect(btn.MouseButton1Click, function() Toggle:SetValue(not Toggle.Value) end)

    Library.Options[Flag] = Toggle
    Library.Flags[Flag] = Toggle.Value
    if Toggle.Value then Toggle:SetValue(true) end
    self:Register(holder, Options.Text or Flag)
    table.insert(Library.SearchIndex, { Flag = Flag, Text = Options.Text or Flag, Tab = self.Tab.Name })
    Toggle.Box = top
    return Toggle
end

-- ═══════════════════════════════════════════════════════════
-- SLIDER  (BigFroot: label left, value right, a thin fill track below with a round knob)
-- ═══════════════════════════════════════════════════════════
function Groupbox:AddSlider(Flag, Options)
    Options = Options or {}
    local min, max = Options.Min or 0, Options.Max or 100
    local decimals = Options.Decimals or 0
    local suffix = Options.Suffix or ""
    local function round(v)
        local m = 10 ^ decimals
        return math.floor(v * m + 0.5) / m
    end

    local hasDesc = Options.Description ~= nil
    local holder = Create("Frame", { Size = UDim2.new(1, 0, 0, hasDesc and 56 or 40), AutomaticSize = Enum.AutomaticSize.Y, BackgroundTransparency = 1, Parent = self.Body })
    Label({ Size = UDim2.new(0.6, 0, 0, 16), Text = Options.Text or Flag, FontFace = FONT.Medium, TextSize = 13, Theme = { TextColor3 = "Text" }, Parent = holder })
    local valueLbl = Label({ AnchorPoint = Vector2.new(1, 0), Position = UDim2.fromScale(1, 0), Size = UDim2.new(0.4, 0, 0, 16), Text = "", FontFace = FONT.SemiBold, TextSize = 13, TextXAlignment = Enum.TextXAlignment.Right, Theme = { TextColor3 = "TextBright" }, Parent = holder })

    local track = Create("Frame", { Position = UDim2.fromOffset(0, 22), Size = UDim2.new(1, 0, 0, 6), Theme = { BackgroundColor3 = "Track" }, Parent = holder })
    Corner(track, 3)
    local fill = Create("Frame", { Size = UDim2.fromScale(0, 1), Theme = { BackgroundColor3 = "Accent" }, Parent = track })
    Corner(fill, 3)
    fill.ZIndex = 2
    local fillGlow = Library:AddGlow(fill, 14, 0.3)
    fillGlow.Parent = track
    local knob = Create("Frame", { AnchorPoint = Vector2.new(0.5, 0.5), Position = UDim2.fromScale(0, 0.5), Size = UDim2.fromOffset(14, 14), Theme = { BackgroundColor3 = "Knob" }, ZIndex = 3, Parent = track })
    Corner(knob, 7)
    local knobGlow = Library:AddGlow(knob, 18, 0.35)
    knobGlow.Parent = track
    knobGlow.AnchorPoint = Vector2.new(0.5, 0.5)
    Library:SetGlow(fillGlow, true)
    Library:SetGlow(knobGlow, true)

    if hasDesc then AddDesc(holder, Options.Description, 32) end

    local Slider = { Value = Options.Default or min, Type = "Slider", Callbacks = {} }
    function Slider:SetValue(v, skip)
        v = math.clamp(round(v), min, max)
        self.Value = v
        Library.Flags[Flag] = v
        local alpha = (max - min) == 0 and 0 or (v - min) / (max - min)
        fill.Size = UDim2.fromScale(alpha, 1)
        knob.Position = UDim2.fromScale(alpha, 0.5)
        fillGlow.Size = UDim2.new(alpha, 14, 1, 14)
        fillGlow.Position = UDim2.fromScale(alpha / 2, 0.5)
        knobGlow.Position = UDim2.fromScale(alpha, 0.5)
        knobGlow.Size = UDim2.fromOffset(32, 32)
        valueLbl.Text = (decimals == 0 and tostring(math.floor(v)) or string.format("%." .. decimals .. "f", v)) .. suffix
        if not skip then
            if Options.Callback then pcall(Options.Callback, v) end
            for _, cb in self.Callbacks do pcall(cb, v) end
        end
    end
    function Slider:OnChanged(fn) table.insert(self.Callbacks, fn); return self end
    function Slider:SetMin(v) min = v; self:SetValue(self.Value) end
    function Slider:SetMax(v) max = v; self:SetValue(self.Value) end

    local sliding = false
    local function moveTo(x)
        local alpha = math.clamp((x - track.AbsolutePosition.X) / track.AbsoluteSize.X, 0, 1)
        Slider:SetValue(min + (max - min) * alpha)
    end
    local hit = Create("TextButton", { Position = UDim2.fromOffset(0, 16), Size = UDim2.new(1, 0, 0, 18), BackgroundTransparency = 1, Text = "", Parent = holder })
    Connect(hit.InputBegan, function(i)
        if i.UserInputType == Enum.UserInputType.MouseButton1 or i.UserInputType == Enum.UserInputType.Touch then sliding = true; moveTo(i.Position.X); Tween(knob, { Size = UDim2.fromOffset(16, 16) }, 0.1) end
    end)
    Connect(UserInputService.InputChanged, function(i)
        if sliding and (i.UserInputType == Enum.UserInputType.MouseMovement or i.UserInputType == Enum.UserInputType.Touch) then moveTo(i.Position.X) end
    end)
    Connect(UserInputService.InputEnded, function(i)
        if i.UserInputType == Enum.UserInputType.MouseButton1 or i.UserInputType == Enum.UserInputType.Touch then if sliding then Tween(knob, { Size = UDim2.fromOffset(14, 14) }, 0.1) end sliding = false end
    end)

    Library.Options[Flag] = Slider
    Slider:SetValue(Slider.Value, true)
    self:Register(holder, Options.Text or Flag)
    table.insert(Library.SearchIndex, { Flag = Flag, Text = Options.Text or Flag, Tab = self.Tab.Name })
    return Slider
end


-- ═══════════════════════════════════════════════════════════
-- DROPDOWN  (BigFroot: field with the value + chevron, opens a list below)
-- ═══════════════════════════════════════════════════════════
function Groupbox:AddDropdown(Flag, Options)
    Options = Options or {}
    local multi = Options.Multi or false
    local values = Options.Values or {}
    local hasDesc = Options.Description ~= nil

    local holder = Create("Frame", { Size = UDim2.new(1, 0, 0, hasDesc and 62 or 44), AutomaticSize = Enum.AutomaticSize.Y, BackgroundTransparency = 1, Parent = self.Body })
    Label({ Size = UDim2.new(1, 0, 0, 16), Text = Options.Text or Flag, FontFace = FONT.Medium, TextSize = 13, Theme = { TextColor3 = "Text" }, Parent = holder })

    local field = Create("TextButton", { Position = UDim2.fromOffset(0, 20), Size = UDim2.new(1, 0, 0, 30), AutoButtonColor = false, Text = "", Theme = { BackgroundColor3 = "Field" }, Parent = holder })
    Corner(field, 6)
    Create("UIStroke", { Thickness = 1, Transparency = 0.6, Theme = { Color = "Divider" }, Parent = field })
    local valueLbl = Label({ Position = UDim2.fromOffset(10, 0), Size = UDim2.new(1, -36, 1, 0), Text = "--", FontFace = FONT.Medium, TextSize = 13, TextTruncate = Enum.TextTruncate.AtEnd, Theme = { TextColor3 = "TextBright" }, Parent = field })
    local arrow = Create("ImageLabel", { AnchorPoint = Vector2.new(1, 0.5), Position = UDim2.new(1, -8, 0.5, 0), Size = UDim2.fromOffset(16, 16), BackgroundTransparency = 1, Image = Icon("chevron-down"), Theme = { ImageColor3 = "SubText" }, Parent = field })

    if hasDesc then AddDesc(holder, Options.Description, 54) end

    local Dropdown = { Value = Options.Default or (multi and {} or nil), Type = "Dropdown", Values = values, Callbacks = {}, Open = false }

    local list = Create("Frame", { Size = UDim2.new(1, 0, 0, 0), AutomaticSize = Enum.AutomaticSize.Y, ClipsDescendants = true, Visible = false, Theme = { BackgroundColor3 = "Field" }, Parent = holder })
    local listPos = Create("Frame", { Position = UDim2.fromOffset(0, hasDesc and 54 or 52), Size = UDim2.new(1, 0, 0, 0), AutomaticSize = Enum.AutomaticSize.Y, BackgroundTransparency = 1, Parent = holder })
    list.Parent = listPos
    Corner(list, 6)
    Create("UIStroke", { Thickness = 1, Transparency = 0.6, Theme = { Color = "Divider" }, Parent = list })
    local inner = Create("Frame", { Size = UDim2.new(1, 0, 0, 0), AutomaticSize = Enum.AutomaticSize.Y, BackgroundTransparency = 1, Parent = list })
    List(inner, 0)
    Pad(inner, 4, 4, 4, 4)

    local function label()
        if multi then
            local picked = {}
            for k, v in Dropdown.Value do if v then table.insert(picked, k) end end
            return #picked > 0 and table.concat(picked, ", ") or "--"
        end
        return Dropdown.Value and tostring(Dropdown.Value) or "--"
    end

    local rows = {}
    local function rebuild()
        for _, r in rows do r:Destroy() end
        table.clear(rows)
        for i, opt in Dropdown.Values do
            local row = Create("TextButton", { Size = UDim2.new(1, 0, 0, 28), BackgroundTransparency = 1, AutoButtonColor = false, Text = "", LayoutOrder = i, Parent = inner })
            Corner(row, 4)
            local on = multi and Dropdown.Value[opt] or (Dropdown.Value == opt)
            local txt = Label({ Position = UDim2.fromOffset(10, 0), Size = UDim2.new(1, -20, 1, 0), Text = tostring(opt), FontFace = FONT.Medium, TextSize = 13, Theme = { TextColor3 = on and "Accent" or "Text" }, Parent = row })
            Connect(row.MouseEnter, function() Tween(row, { BackgroundColor3 = Library.Theme.Hover }, 0.1); row.BackgroundTransparency = 0 end)
            Connect(row.MouseLeave, function() row.BackgroundTransparency = 1 end)
            Connect(row.MouseButton1Click, function()
                if multi then
                    Dropdown.Value[opt] = not Dropdown.Value[opt] or nil
                    txt.TextColor3 = Dropdown.Value[opt] and Library.Theme.Accent or Library.Theme.Text
                else
                    Dropdown:SetValue(opt)
                    Dropdown:Toggle(false)
                end
                valueLbl.Text = label()
                if multi then Dropdown:_fire() end
            end)
            rows[i] = row
        end
    end

    function Dropdown:Toggle(state)
        self.Open = state == nil and not self.Open or state
        list.Visible = self.Open
        Tween(arrow, { Rotation = self.Open and 180 or 0 }, 0.18)
        if self.Open then Library:ClosePopup(self); Library.OpenPopup = self end
    end
    function Dropdown:_fire()
        Library.Flags[Flag] = self.Value
        if Options.Callback then pcall(Options.Callback, self.Value) end
        for _, cb in self.Callbacks do pcall(cb, self.Value) end
    end
    function Dropdown:SetValue(v, skip)
        self.Value = v
        valueLbl.Text = label()
        rebuild()
        if not skip then self:_fire() end
    end
    function Dropdown:SetValues(list2) self.Values = list2 or {}; rebuild() end
    function Dropdown:OnChanged(fn) table.insert(self.Callbacks, fn); return self end
    Dropdown.Refresh = Dropdown.SetValues

    Connect(field.MouseButton1Click, function() Dropdown:Toggle() end)
    rebuild()
    valueLbl.Text = label()
    Library.Options[Flag] = Dropdown
    if Dropdown.Value ~= nil then Library.Flags[Flag] = Dropdown.Value end
    self:Register(holder, Options.Text or Flag)
    table.insert(Library.SearchIndex, { Flag = Flag, Text = Options.Text or Flag, Tab = self.Tab.Name })
    return Dropdown
end

function Library:ClosePopup(except)
    if self.OpenPopup and self.OpenPopup ~= except and self.OpenPopup.Toggle then
        self.OpenPopup:Toggle(false)
    end
    if self.OpenPopup == except then return end
    self.OpenPopup = nil
end


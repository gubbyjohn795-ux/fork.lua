        Library.Flags[Flag] = Toggle.Value
        Library.Options[Flag] = Toggle
        RegisterSearchEntry(Options.Text or "Toggle", "Toggle", Flag, self)
    end
    Visual()
    RegisterAccent(Visual)

    function Toggle.AddKeybind(_, KeyOptions)

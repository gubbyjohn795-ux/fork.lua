    Keybind.Listening = false
    Keybind.Menu = nil
    Keybind.MenuParts = nil

    local function KeyName()
        if not Keybind.Key then
            return ". . ."
        end
        return Keybind.Key.Name
    end

    local function CloseMenu()
        if not Keybind.Menu then
            return
        end
        local Menu = Keybind.Menu

local function Icon(name)
    if type(name) == "number" then return "rbxassetid://" .. name end
    if type(name) == "string" and name:find("rbxassetid://") then return name end
    local id = ICONS[name or ""]
    return id and ("rbxassetid://" .. id) or ""
end


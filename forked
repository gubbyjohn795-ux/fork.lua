-- ═══════════════════════════════════════════════════════════
function Groupbox:AddButton(Options)
    if type(Options) == "string" then Options = { Text = Options } end
    Options = Options or {}
    local holder = Create("Frame", { Size = UDim2.new(1, 0, 0, Options.Description and 48 or 32), BackgroundTransparency = 1, Parent = self.Body })
    local btn = Create("TextButton", { Size = UDim2.new(1, 0, 0, 32), AutoButtonColor = false, Text = Options.Text or "Button", FontFace = FONT.SemiBold, TextSize = 13, Theme = { BackgroundColor3 = "Element", TextColor3 = "TextBright" }, Parent = holder })
    Corner(btn, 6)
    Create("UIStroke", { Thickness = 1, Transparency = 0.6, Theme = { Color = "Divider" }, Parent = btn })
    if Options.Description then AddDesc(holder, Options.Description, 36) end

    Connect(btn.MouseEnter, function() Tween(btn, { BackgroundColor3 = Library.Theme.Hover }, 0.12) end)
    Connect(btn.MouseLeave, function() Tween(btn, { BackgroundColor3 = Library.Theme.Element }, 0.12) end)
    local last = 0
    Connect(btn.MouseButton1Click, function()
        if Options.DoubleClick and os.clock() - last > 0.4 then last = os.clock(); btn.Text = "Are you sure?"; task.delay(1, function() btn.Text = Options.Text or "Button" end); return end
        Tween(btn, { BackgroundColor3 = Library.Theme.Accent }, 0.08)
        task.delay(0.1, function() Tween(btn, { BackgroundColor3 = Library.Theme.Element }, 0.12) end)
        if Options.Func then pcall(Options.Func) end
        if Options.Callback then pcall(Options.Callback) end
    end)

    local B = { Type = "Button" }
    function B:SetText(t) btn.Text = t end
    self:Register(holder, Options.Text)
    return B
end


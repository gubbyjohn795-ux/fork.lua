    local function RunSearch(query)
        ClearSearchResults()
        if query == "" then
            SearchOverlay.Visible = false
            SearchCount.Text = ""
            Tween(SearchStroke, { Color = Theme.Stroke }, 0.15)
            return
        end

        Tween(SearchStroke, { Color = Theme.AccentText }, 0.15)
        local lower = string.lower(query)
        local matches = 0

        for _, entry in ipairs(Library.SearchIndex) do
            local nameL = string.lower(entry.Name)
            local pathL = string.lower(entry.Path)
            local catL = string.lower(entry.Category)
            local typeL = string.lower(entry.Type)
            local gbL = string.lower(entry.GroupboxName)
            if string.find(nameL, lower, 1, true) or string.find(catL, lower, 1, true) or string.find(pathL, lower, 1, true) or string.find(typeL, lower, 1, true) or string.find(gbL, lower, 1, true) then
                matches = matches + 1
                MakeSearchResult(entry, matches)
                if matches >= 50 then break end
            end
        end

        SearchCount.Text = matches .. (matches == 1 and " match" or " matches")
        SearchOverlay.Visible = matches > 0
        local contentH = math.min(matches * 36 + 8, 240)
        SearchOverlay.Size = UDim2.new(0, 260, 0, contentH)
    end


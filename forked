-- ── helpers ──
local function Connect(signal, fn)
    local c = signal:Connect(fn)
    table.insert(Library.Connections, c)
    return c
end

local function Tween(obj, props, t, style, dir)
    local tw = TweenService:Create(obj, TweenInfo.new(t or 0.18, style or Enum.EasingStyle.Quad, dir or Enum.EasingDirection.Out), props)
    tw:Play()
    return tw
end

local function Themed(obj, props)
    Library.Registry[obj] = props
    for prop, key in props do
        if Library.Theme[key] then obj[prop] = Library.Theme[key] end
    end
    return obj
end

local function Create(class, props, children)
    local o = Instance.new(class)
    local theme = props.Theme
    for k, v in props do
        if k ~= "Parent" and k ~= "Theme" then o[k] = v end
    end
    if theme then Themed(o, theme) end
    for _, c in children or {} do c.Parent = o end
    if props.Parent then o.Parent = props.Parent end
    return o
end

-- real glow: a soft accent halo sitting behind the element, not a border
Library.Glows = {}
local GLOW_IMAGE = "rbxassetid://112971167999062"

function Library:AddGlow(target, spread, strength)
    local glow = Instance.new("ImageLabel")
    glow.BackgroundTransparency = 1
    glow.Image = GLOW_IMAGE
    glow.ImageColor3 = self.Theme.Accent
    glow.ScaleType = Enum.ScaleType.Slice
    glow.SliceCenter = Rect.new(112, 112, 147, 147)
    glow.SliceScale = 0.5
    glow.AnchorPoint = Vector2.new(0.5, 0.5)
    glow.Position = UDim2.fromScale(0.5, 0.5)
    glow.Size = UDim2.new(1, spread or 18, 1, spread or 18)
    glow.ZIndex = (target.ZIndex or 1) - 1
    glow.ImageTransparency = 1
    glow.Parent = target.Parent
    self.Glows[glow] = { target = target, strength = strength or 0.35, lit = false }
    return glow
end

function Library:SetGlow(glow, lit)
    local info = self.Glows[glow]
    if not info then return end
    info.lit = lit
    glow.ImageColor3 = self.Theme.Accent
    Tween(glow, { ImageTransparency = (lit and self.Glow.Element) and info.strength or 1 }, 0.15)
end

function Library:ApplyGlow()
    for glow, info in self.Glows do
        if glow.Parent then
            glow.ImageColor3 = self.Theme.Accent
            glow.ImageTransparency = (info.lit and self.Glow.Element) and info.strength or 1
        else
            self.Glows[glow] = nil
        end
    end
end

local function Corner(o, r) return Create("UICorner", { CornerRadius = UDim.new(0, r or 6), Parent = o }) end
local function Pad(o, l, r, t, b)
    return Create("UIPadding", { PaddingLeft = UDim.new(0, l or 0), PaddingRight = UDim.new(0, r or l or 0), PaddingTop = UDim.new(0, t or l or 0), PaddingBottom = UDim.new(0, b or t or l or 0), Parent = o })
end
local function List(o, pad, dir, halign, valign)
    return Create("UIListLayout", {
        Padding = UDim.new(0, pad or 0), FillDirection = dir or Enum.FillDirection.Vertical, SortOrder = Enum.SortOrder.LayoutOrder,
        HorizontalAlignment = halign or Enum.HorizontalAlignment.Left, VerticalAlignment = valign or Enum.VerticalAlignment.Top, Parent = o,
    })
end

-- ── fonts: Builder Sans, same as BigFroot ──
local function F(w) return Font.new("rbxasset://fonts/families/BuilderSans.json", Enum.FontWeight[w]) end
local FONT = { Regular = F("Regular"), Medium = F("Medium"), SemiBold = F("SemiBold"), Bold = F("Bold") }

local function TextWidth(text, size, font)
    local ok, v = pcall(function()
        local p = Instance.new("GetTextBoundsParams")
        p.Text, p.Font, p.Size, p.Width = text, font or FONT.Medium, size, 10000
        return TextService:GetTextBoundsAsync(p).X
    end)
    return ok and v or #text * size * 0.5
end

local function Label(props)
    props.BackgroundTransparency = 1
    props.FontFace = props.FontFace or FONT.Medium
    props.TextSize = props.TextSize or 13
    props.TextXAlignment = props.TextXAlignment or Enum.TextXAlignment.Left
    props.Theme = props.Theme or { TextColor3 = "Text" }
    return Create("TextLabel", props)
end


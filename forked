-- QUEUE ON TELEPORT  (re-runs the loader after a server hop)
-- ═══════════════════════════════════════════════════════════
function Library:SetupQueueOnTeleport(script)
    self.QueueScript = script
    local q = queue_on_teleport or (syn and syn.queue_on_teleport) or queueonteleport
    if not q or not script then return false end
    Connect(TeleportService.LocalPlayerArrivedFromTeleport and TeleportService.LocalPlayerArrivedFromTeleport or TeleportService.TeleportInitFailed, function() end)
    pcall(q, script)
    return true
end


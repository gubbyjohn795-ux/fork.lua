-- hook the search once a window exists; call after building tabs
local _origCreateWindow = Library.CreateWindow
function Library:CreateWindow(Config)
    local W = _origCreateWindow(self, Config)
    task.defer(function()
        self:HookSearch(W)
        if Config and Config.QueueScript then self:SetupQueueOnTeleport(Config.QueueScript) end
    end)
    return W
end


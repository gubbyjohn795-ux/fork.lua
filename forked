function Library:ApplyTheme(theme)
    if type(theme) == "string" then
        self.ThemeName = theme
        theme = self.Presets[theme]
    end
    if not theme then return end
    for k, v in theme do self.Theme[k] = v end
    for obj, props in self.Registry do
        if obj.Parent then
            for prop, key in props do
                if self.Theme[key] then obj[prop] = self.Theme[key] end
            end
        else
            self.Registry[obj] = nil
        end
    end
    if self.ApplyGlow then self:ApplyGlow() end
    if self.OnThemeChanged then pcall(self.OnThemeChanged) end
end

function Library:SetThemeColor(key, color)
    self.Theme[key] = color
    if key == "Element" then self.Theme.Hover, self.Theme.Track, self.Theme.Divider = color:Lerp(WHITE, 0.05), color, color:Lerp(WHITE, 0.05) end
    if key == "Panel" then self.Theme.Field = color end
    self:ApplyTheme(self.Theme)
end

-- Ethos names kept
function Library:SetAccent(color) self:SetThemeColor("Accent", color) end
function Library:ApplyFullTheme() self:ApplyTheme(self.Theme) end

Library:ApplyTheme("BigFroot")


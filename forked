-- SETTINGS TAB  (Configs + Theme, matching the BigFroot Settings page)
-- ═══════════════════════════════════════════════════════════
function Library:CreateSettingsTab(W)
    local cat
    for _, c in W.Categories do if c.Name == "SETTINGS" or c.Name == "Other" then cat = c break end end
    cat = cat or W:AddCategory("Other")
    local tab = cat:AddTab("Settings", "settings")

    -- Configs
    local cfg = tab:AddGroupbox("Configs", "folder")
    local nameBox = cfg:AddInput("_ZeroConfigName", { Text = "Config Name", Placeholder = "config name" })
    local cfgList = cfg:AddDropdown("_ZeroConfigList", { Text = "Saved Configs", Values = {}, Default = nil })
    local function configDir() return W.Config.Folder or Library.Folder end
    local function cfgPath(n) return configDir() .. "/configs/" .. n .. ".json" end
    local function listConfigs()
        local out = {}
        pcall(function() for _, f in listfiles(configDir() .. "/configs") do local n = f:match("([^/\\]+)%.json$"); if n then table.insert(out, n) end end end)
        return out
    end
    pcall(function() if makefolder and not isfolder(configDir() .. "/configs") then makefolder(configDir()); makefolder(configDir() .. "/configs") end end)
    cfgList:SetValues(listConfigs())

    cfg:AddButton({ Text = "Create", Func = function()
        local n = Library.Flags._ZeroConfigName
        if not n or n == "" then return Library:Notify({ Title = "Configs", Description = "Type a name first." }) end
        Library:SaveConfig(cfgPath(n)); cfgList:SetValues(listConfigs()); Library:Notify({ Title = "Configs", Description = "Saved " .. n })
    end })
    cfg:AddButton({ Text = "Load", Func = function()
        local n = Library.Flags._ZeroConfigList
        if n then Library:LoadConfig(cfgPath(n)); Library:Notify({ Title = "Configs", Description = "Loaded " .. n }) end
    end })
    cfg:AddButton({ Text = "Save", Func = function()
        local n = Library.Flags._ZeroConfigList or Library.Flags._ZeroConfigName
        if n and n ~= "" then Library:SaveConfig(cfgPath(n)); Library:Notify({ Title = "Configs", Description = "Saved " .. n }) end
    end })
    cfg:AddButton({ Text = "Delete", DoubleClick = true, Func = function()
        local n = Library.Flags._ZeroConfigList
        if n then pcall(delfile, cfgPath(n)); cfgList:SetValues(listConfigs()); Library:Notify({ Title = "Configs", Description = "Deleted " .. n }) end
    end })
    cfg:AddDivider()
    local autoDrop = cfg:AddDropdown("_ZeroAutoload", { Text = "Autoload", Values = listConfigs() })
    cfg:AddButton({ Text = "Set Autoload", Func = function()
        local n = Library.Flags._ZeroConfigList
        if n then pcall(writefile, configDir() .. "/autoload.txt", n); Library:Notify({ Title = "Configs", Description = "Autoloads " .. n }) end
    end })
    cfg:AddButton({ Text = "Clear Autoload", Func = function() pcall(delfile, configDir() .. "/autoload.txt"); Library:Notify({ Title = "Configs", Description = "Autoload cleared" }) end })

    -- Theme
    local th = tab:AddGroupbox("Theme", "palette")
    th:AddDropdown("_ZeroTheme", { Text = "Preset", Values = Library.PresetNames, Default = Library.ThemeName, Callback = function(v) Library:ApplyTheme(v) end })
    th:AddToggle("_ZeroWindowGlow", { Text = "Window Glow", Default = false, Callback = function(v) Library.Glow.Window = v; if W.Glow then Tween(W.Glow, { ImageTransparency = v and 0.25 or 1 }, 0.2) end end })
    th:AddToggle("_ZeroElementGlow", { Text = "Element Glow", Default = true, Callback = function(v) Library.Glow.Element = v; Library:ApplyGlow() end })
    th:AddSlider("_ZeroCardOpacity", { Text = "Card Opacity", Min = 0.3, Max = 1, Default = 1, Decimals = 2, Callback = function(v)
        Library.Opacity.Card = v
        for obj, props in Library.Registry do if props.BackgroundColor3 == "Panel" and obj.Parent then obj.BackgroundTransparency = 1 - v end end
    end })
    th:AddSlider("_ZeroWindowOpacity", { Text = "Window Opacity", Min = 0.3, Max = 1, Default = 1, Decimals = 2, Callback = function(v)
        Library.Opacity.Window = v
        if W.Main then W.Main.GroupTransparency = 1 - v end
    end })
    th:AddToggle("_ZeroAccentGradient", { Text = "Accent Gradient", Default = false, Callback = function(v) Library.Gradient.Accent = v end })
    th:AddToggle("_ZeroWindowGradient", { Text = "Window Gradient", Default = false, Callback = function(v) Library.Gradient.Window = v; if W.WindowGradient then W.WindowGradient.Enabled = v end end })

    -- the editable color rows (Background / Panel / Element / Hover), like the BigFroot Settings screenshot
    local colors = tab:AddGroupbox("Colors", "sliders")
    local function colorRow(label, key)
        colors:AddColorPicker("_ZeroColor_" .. key, { Text = label, Default = Library.Theme[key], Callback = function(c) Library:SetThemeColor(key, c) end })
    end
    colorRow("Accent", "Accent")
    colorRow("Background", "Background")
    colorRow("Panel", "Panel")
    colorRow("Element", "Element")
    return tab
end


-- ═══════════════════════════════════════════════════════════
-- CONFIG SAVE / LOAD
-- ═══════════════════════════════════════════════════════════
local function SerializeValue(v)
    if typeof(v) == "Color3" then return { __t = "Color3", v.R, v.G, v.B } end
    if typeof(v) == "EnumItem" then return { __t = "Enum", tostring(v) } end
    return v
end
local function DeserializeValue(v)
    if type(v) == "table" and v.__t == "Color3" then return Color3.new(v[1], v[2], v[3]) end
    if type(v) == "table" and v.__t == "Enum" then
        local path = v[2]:split(".")
        local e = Enum
        for i = 2, #path do e = e[path[i]] end
        return e
    end
    return v
end

function Library:SaveConfig(path)
    local data = {}
    for flag, opt in self.Options do
        if not flag:find("^_Zero") then
            if opt.Type == "Keybind" then
                data[flag] = opt.Value and { __t = "Enum", tostring(opt.Value) } or false
            else
                data[flag] = SerializeValue(opt.Value)
            end
        end
    end
    pcall(writefile, path, HttpService:JSONEncode(data))
end

function Library:LoadConfig(path)
    local raw = SafeFile(readfile, path)
    if not raw then return end
    local ok, data = pcall(HttpService.JSONDecode, HttpService, raw)
    if not ok then return end
    for flag, v in data do
        local opt = self.Options[flag]
        if opt and opt.SetValue then pcall(opt.SetValue, opt, DeserializeValue(v)) end
    end
end

function Library:TryAutoload(folder)
    folder = folder or self.Folder
    local name = SafeFile(readfile, folder .. "/autoload.txt")
    if name then
        task.delay(1.5, function() self:LoadConfig(folder .. "/configs/" .. name .. ".json") end)
    end
end


-- INPUT  (field you can type in)
-- ═══════════════════════════════════════════════════════════
function Groupbox:AddInput(Flag, Options)
    Options = Options or {}
    local hasDesc = Options.Description ~= nil
    local holder = Create("Frame", { Size = UDim2.new(1, 0, 0, hasDesc and 62 or 44), AutomaticSize = Enum.AutomaticSize.Y, BackgroundTransparency = 1, Parent = self.Body })
    Label({ Size = UDim2.new(1, 0, 0, 16), Text = Options.Text or Flag, FontFace = FONT.Medium, TextSize = 13, Theme = { TextColor3 = "Text" }, Parent = holder })
    local field = Create("Frame", { Position = UDim2.fromOffset(0, 20), Size = UDim2.new(1, 0, 0, 30), Theme = { BackgroundColor3 = "Field" }, Parent = holder })
    Corner(field, 6)
    Create("UIStroke", { Thickness = 1, Transparency = 0.6, Theme = { Color = "Divider" }, Parent = field })
    local box = Create("TextBox", {
        Position = UDim2.fromOffset(10, 0), Size = UDim2.new(1, -20, 1, 0), BackgroundTransparency = 1, Text = Options.Default or "",
        PlaceholderText = Options.Placeholder or "", FontFace = FONT.Medium, TextSize = 13, TextXAlignment = Enum.TextXAlignment.Left,
        ClearTextOnFocus = Options.ClearOnFocus or false, TextTruncate = Enum.TextTruncate.AtEnd,
        Theme = { TextColor3 = "TextBright", PlaceholderColor3 = "SubText" }, Parent = field,
    })
    if hasDesc then AddDesc(holder, Options.Description, 54) end

    local Input = { Value = Options.Default or "", Type = "Input", Callbacks = {} }
    function Input:SetValue(v) box.Text = tostring(v); self.Value = box.Text; Library.Flags[Flag] = self.Value end
    function Input:OnChanged(fn) table.insert(self.Callbacks, fn); return self end
    local function fire()
        Input.Value = box.Text
        Library.Flags[Flag] = box.Text
        if Options.Callback then pcall(Options.Callback, box.Text) end
        for _, cb in Input.Callbacks do pcall(cb, box.Text) end
    end
    Connect(box.FocusLost, function(enter) if not Options.EnterOnly or enter then fire() end end)
    if not Options.EnterOnly then Connect(box:GetPropertyChangedSignal("Text"), function() if not box:IsFocused() then return end Input.Value = box.Text; Library.Flags[Flag] = box.Text end) end

    Library.Options[Flag] = Input
    Library.Flags[Flag] = Input.Value
    self:Register(holder, Options.Text or Flag)
    table.insert(Library.SearchIndex, { Flag = Flag, Text = Options.Text or Flag, Tab = self.Tab.Name })
    return Input
end


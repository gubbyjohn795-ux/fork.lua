    ["aimbot"] = "crosshair", ["silent aim"] = "eye", ["crosshairs"] = "crosshair", ["skins"] = "user",
}
local function NavIcon(name) return NAV_ICONS[(name or ""):lower()] or "layout-dashboard" end

function Window:AddCategory(Name)
    -- a sidebar group: a clickable header with a chevron, and the tabs under it
    local C = setmetatable({ Window = self, Name = Name, Tabs = {}, Rows = {}, Order = #self.Categories * 100, Collapsed = false }, Category)

    local head = Create("TextButton", { Size = UDim2.new(1, 0, 0, 26), BackgroundTransparency = 1, AutoButtonColor = false, Text = "", LayoutOrder = C.Order, Parent = self.Nav })
    Label({ Position = UDim2.fromOffset(14, 0), Size = UDim2.new(1, -40, 1, 0), Text = Name, FontFace = FONT.Medium, TextSize = 12, Theme = { TextColor3 = "SubText" }, Parent = head })
    local chev = Create("ImageLabel", { AnchorPoint = Vector2.new(1, 0.5), Position = UDim2.new(1, -12, 0.5, 0), Size = UDim2.fromOffset(14, 14), BackgroundTransparency = 1, Image = Icon("chevron-down"), Theme = { ImageColor3 = "SubText" }, Parent = head })
    C.Header, C.Chevron = head, chev

    function C:SetCollapsed(state)
        self.Collapsed = state
        for _, row in self.Rows do row.Visible = not state end
        Tween(chev, { Rotation = state and -90 or 0 }, 0.18)
    end
    Connect(head.MouseButton1Click, function() C:SetCollapsed(not C.Collapsed) end)

    table.insert(self.Categories, C)
    return C
end

function Category:AddTab(Name, iconOverride)
    local W = self.Window
    local order = self.Order + #self.Tabs + 1

    local row = Create("TextButton", { Size = UDim2.new(1, 0, 0, 30), BackgroundTransparency = 1, AutoButtonColor = false, Text = "", LayoutOrder = order, Parent = W.Nav })
    local bar = Create("Frame", { AnchorPoint = Vector2.new(0, 0.5), Position = UDim2.fromScale(0, 0.5), Size = UDim2.fromOffset(3, 0), BackgroundTransparency = 1, Theme = { BackgroundColor3 = "Accent" }, Parent = row })
    Corner(bar, 2)
    local icon = Create("ImageLabel", { Position = UDim2.fromOffset(26, 7), Size = UDim2.fromOffset(16, 16), BackgroundTransparency = 1, Image = Icon(iconOverride or NavIcon(Name)), Theme = { ImageColor3 = "SubText" }, Parent = row })
    local text = Label({ Position = UDim2.fromOffset(50, 0), Size = UDim2.new(1, -58, 1, 0), Text = Name, FontFace = FONT.Medium, TextSize = 13, Theme = { TextColor3 = "SubText" }, Parent = row })

    local page = Create("ScrollingFrame", {
        Size = UDim2.fromScale(1, 1), BackgroundTransparency = 1, BorderSizePixel = 0, Visible = false,
        ScrollBarThickness = 3, ScrollBarImageColor3 = Color3.fromRGB(60, 60, 70), ScrollBarImageTransparency = 0.4,
        CanvasSize = UDim2.new(), AutomaticCanvasSize = Enum.AutomaticSize.Y, Parent = W.Content,
    })
    Pad(page, 0, 0, 0, 14)
    -- two columns of groupboxes, like BigFroot. sized in offsets so nothing runs past the window edge
    local cols = Create("Frame", { Position = UDim2.fromOffset(14, 14), Size = UDim2.new(1, -32, 0, 0), AutomaticSize = Enum.AutomaticSize.Y, BackgroundTransparency = 1, Parent = page })
    List(cols, 12, Enum.FillDirection.Horizontal)
    local left = Create("Frame", { Size = UDim2.new(0.5, -6, 0, 0), AutomaticSize = Enum.AutomaticSize.Y, BackgroundTransparency = 1, LayoutOrder = 1, Parent = cols })
    local right = Create("Frame", { Size = UDim2.new(0.5, -6, 0, 0), AutomaticSize = Enum.AutomaticSize.Y, BackgroundTransparency = 1, LayoutOrder = 2, Parent = cols })
    List(left, 12)
    List(right, 12)

    local T = setmetatable({
        Window = W, Category = self, Name = Name, Page = page, Row = row, Bar = bar, Icon = icon, Text = text,
        Columns = { left, right }, GroupCount = 0, Groupboxes = {},
    }, Tab)
    table.insert(self.Tabs, T)
    table.insert(self.Rows, row)
    table.insert(W.Tabs, T)

    Connect(row.MouseEnter, function() if W.ActiveTab ~= T then Tween(text, { TextColor3 = Library.Theme.Text }, 0.12) end end)
    Connect(row.MouseLeave, function() if W.ActiveTab ~= T then Tween(text, { TextColor3 = Library.Theme.SubText }, 0.12) end end)
    Connect(row.MouseButton1Click, function() T:Select() end)

    if not W.ActiveTab then T:Select() end
    return T
end

function Tab:Select()
    local W = self.Window
    if W.ActiveTab == self then return end
    if W.ActiveTab then
        local old = W.ActiveTab
        old.Page.Visible = false
        Tween(old.Bar, { Size = UDim2.fromOffset(3, 0), BackgroundTransparency = 1 }, 0.15)
        Tween(old.Icon, { ImageColor3 = Library.Theme.SubText }, 0.15)
        Tween(old.Text, { TextColor3 = Library.Theme.SubText }, 0.15)
        old.Text.FontFace = FONT.Medium
    end
    W.ActiveTab = self
    self.Page.Visible = true
    Tween(self.Bar, { Size = UDim2.fromOffset(3, 18), BackgroundTransparency = 0 }, 0.18)
    Tween(self.Icon, { ImageColor3 = Library.Theme.Accent }, 0.18)
    Tween(self.Text, { TextColor3 = Library.Theme.TextBright }, 0.18)
    self.Text.FontFace = FONT.SemiBold

    local a = Library.Theme.Accent
    W.Crumb.Text = string.format('<font color="rgb(%d,%d,%d)">%s</font>  ›  %s', a.R * 255, a.G * 255, a.B * 255, self.Category.Name, self.Name)

    -- fade the page in
    FadeInPage(self.Page)
end

-- a quick page fade using a transparency sweep on the scrolling frame's children
function FadeInPage(page)
    for _, d in page:GetDescendants() do
        if d:IsA("GuiObject") then
            local bt = d.BackgroundTransparency
            if bt < 1 then
                d.BackgroundTransparency = 1
                Tween(d, { BackgroundTransparency = bt }, 0.2)
            end
        end
    end
end

-- the next group goes in whichever column is shorter, so the two columns stay even
function Tab:NextColumn()
    local l, r = self.Columns[1].AbsoluteSize.Y, self.Columns[2].AbsoluteSize.Y
    return (l <= r) and self.Columns[1] or self.Columns[2]
end

-- ── search: dims tabs whose names don't match, and highlights the first that does ──
function Library:HookSearch(W)
    Connect(W.SearchBox:GetPropertyChangedSignal("Text"), function()
        local q = W.SearchBox.Text:lower()
        for _, T in W.Tabs do
            local hit = q == "" or T.Name:lower():find(q, 1, true) ~= nil
            for _, gb in T.Groupboxes do
                for _, entry in gb.Entries or {} do
                    local match = q == "" or (entry.Text and entry.Text:lower():find(q, 1, true))
                    entry.Holder.Visible = match and true or false
                end
            end
            T.Row.Visible = (q == "" or hit or T.AnyMatch)
        end
    end)
end



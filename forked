        local AccBrightness = Theme.Accent.R * 0.299 + Theme.Accent.G * 0.587 + Theme.Accent.B * 0.114
        local TickColor = AccBrightness > 0.25 and Color3.fromRGB(0, 0, 0) or Color3.fromRGB(255, 255, 255)

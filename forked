local function LoadingScreen(title, version, parent)
    local gui = Create("ScreenGui", { Name = HttpService:GenerateGUID(false), IgnoreGuiInset = true, DisplayOrder = 99999, ZIndexBehavior = Enum.ZIndexBehavior.Sibling, ResetOnSpawn = false, Parent = parent })
    local card = Create("CanvasGroup", { AnchorPoint = Vector2.new(0.5, 0.5), Position = UDim2.fromScale(0.5, 0.52), Size = UDim2.fromOffset(300, 116), GroupTransparency = 1, Theme = { BackgroundColor3 = "Panel" }, Parent = gui })
    Corner(card, 10)
    Label({ Position = UDim2.fromOffset(16, 17), Size = UDim2.new(1, -78, 0, 18), Text = title or "Zero Hub", FontFace = FONT.Bold, TextSize = 16, Theme = { TextColor3 = "TextBright" }, Parent = card })
    Label({ Position = UDim2.fromOffset(16, 35), Size = UDim2.new(1, -78, 0, 14), Text = version or "", FontFace = FONT.Regular, TextSize = 12, Theme = { TextColor3 = "SubText" }, Parent = card })
    local track = Create("Frame", { Position = UDim2.new(0, 16, 1, -40), Size = UDim2.new(1, -32, 0, 4), Theme = { BackgroundColor3 = "Track" }, Parent = card })
    Corner(track, 2)
    local fill = Create("Frame", { Size = UDim2.fromScale(0, 1), Theme = { BackgroundColor3 = "Accent" }, Parent = track })
    Corner(fill, 2)
    local status = Label({ Position = UDim2.new(0, 16, 1, -30), Size = UDim2.new(1, -32, 0, 16), Text = "Loading...", FontFace = FONT.Regular, TextSize = 12, Theme = { TextColor3 = "SubText" }, Parent = card })

    Tween(card, { GroupTransparency = 0, Position = UDim2.fromScale(0.5, 0.5) }, 0.35)
    local steps = { "Loading interface", "Loading settings", "Ready" }
    for i, s in steps do
        status.Text = s
        Tween(fill, { Size = UDim2.fromScale(i / #steps, 1) }, 0.3)
        task.wait(0.32)
    end
    Tween(card, { GroupTransparency = 1, Position = UDim2.fromScale(0.5, 0.48) }, 0.3)
    task.wait(0.3)
    gui:Destroy()
end


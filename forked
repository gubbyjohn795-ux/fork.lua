-- ═══════════════════════════════════════════════════════════
-- COLOR PICKER POPUP
-- ═══════════════════════════════════════════════════════════
function Library:OpenColorPicker(Picker, anchor)
    if self.PickerGui then self.PickerGui:Destroy() end
    local gui = Create("ScreenGui", { Name = HttpService:GenerateGUID(false), IgnoreGuiInset = true, DisplayOrder = 99998, ResetOnSpawn = false, Parent = GuiParent() })
    self.PickerGui = gui
    local blocker = Create("TextButton", { Size = UDim2.fromScale(1, 1), BackgroundTransparency = 1, Text = "", Parent = gui })
    local pos = anchor.AbsolutePosition
    local pop = Create("Frame", { Position = UDim2.fromOffset(math.min(pos.X - 160, workspace.CurrentCamera.ViewportSize.X - 200), pos.Y + 24), Size = UDim2.fromOffset(190, 170), Theme = { BackgroundColor3 = "Panel" }, Parent = gui })
    Corner(pop, 8)
    Create("UIStroke", { Thickness = 1, Transparency = 0.4, Theme = { Color = "Divider" }, Parent = pop })

    local h, s, v = Picker.Value:ToHSV()
    local sat = Create("ImageButton", { Position = UDim2.fromOffset(10, 10), Size = UDim2.fromOffset(140, 110), BackgroundColor3 = Color3.fromHSV(h, 1, 1), AutoButtonColor = false, Parent = pop })
    Corner(sat, 4)
    Create("UIGradient", { Color = ColorSequence.new(Color3.new(1, 1, 1), Color3.new(1, 1, 1)), Transparency = NumberSequence.new({ NumberSequenceKeypoint.new(0, 0), NumberSequenceKeypoint.new(1, 1) }), Parent = sat })
    local black = Create("Frame", { Size = UDim2.fromScale(1, 1), BackgroundColor3 = Color3.new(0, 0, 0), BorderSizePixel = 0, Parent = sat })
    Corner(black, 4)
    Create("UIGradient", { Rotation = 90, Color = ColorSequence.new(Color3.new(0, 0, 0), Color3.new(0, 0, 0)), Transparency = NumberSequence.new({ NumberSequenceKeypoint.new(0, 1), NumberSequenceKeypoint.new(1, 0) }), Parent = black })
    local cursor = Create("Frame", { AnchorPoint = Vector2.new(0.5, 0.5), Size = UDim2.fromOffset(8, 8), BackgroundColor3 = Color3.new(1, 1, 1), ZIndex = 5, Parent = sat })
    Corner(cursor, 4)
    Create("UIStroke", { Thickness = 1.5, Color = Color3.new(0, 0, 0), Parent = cursor })

    local hueBar = Create("ImageButton", { Position = UDim2.fromOffset(158, 10), Size = UDim2.fromOffset(20, 110), AutoButtonColor = false, Parent = pop })
    Corner(hueBar, 4)
    Create("UIGradient", { Rotation = 90, Color = ColorSequence.new({
        ColorSequenceKeypoint.new(0, Color3.fromHSV(0, 1, 1)), ColorSequenceKeypoint.new(0.17, Color3.fromHSV(0.17, 1, 1)), ColorSequenceKeypoint.new(0.33, Color3.fromHSV(0.33, 1, 1)),
        ColorSequenceKeypoint.new(0.5, Color3.fromHSV(0.5, 1, 1)), ColorSequenceKeypoint.new(0.67, Color3.fromHSV(0.67, 1, 1)), ColorSequenceKeypoint.new(0.83, Color3.fromHSV(0.83, 1, 1)), ColorSequenceKeypoint.new(1, Color3.fromHSV(1, 1, 1)),
    }), Parent = hueBar })
    local hueCursor = Create("Frame", { AnchorPoint = Vector2.new(0.5, 0.5), Position = UDim2.fromScale(0.5, h), Size = UDim2.new(1, 4, 0, 3), BackgroundColor3 = Color3.new(1, 1, 1), ZIndex = 5, Parent = hueBar })
    Create("UIStroke", { Thickness = 1, Color = Color3.new(0, 0, 0), Parent = hueCursor })

    local function apply()
        sat.BackgroundColor3 = Color3.fromHSV(h, 1, 1)
        cursor.Position = UDim2.fromScale(s, 1 - v)
        hueCursor.Position = UDim2.fromScale(0.5, h)
        Picker:SetValue(Color3.fromHSV(h, s, v))
    end
    apply()
    local draggingSat, draggingHue
    Connect(sat.InputBegan, function(i) if i.UserInputType == Enum.UserInputType.MouseButton1 then draggingSat = true end end)
    Connect(hueBar.InputBegan, function(i) if i.UserInputType == Enum.UserInputType.MouseButton1 then draggingHue = true end end)
    Connect(UserInputService.InputEnded, function(i) if i.UserInputType == Enum.UserInputType.MouseButton1 then draggingSat, draggingHue = false, false end end)
    Connect(UserInputService.InputChanged, function(i)
        if i.UserInputType ~= Enum.UserInputType.MouseMovement then return end
        if draggingSat then
            s = math.clamp((i.Position.X - sat.AbsolutePosition.X) / sat.AbsoluteSize.X, 0, 1)
            v = 1 - math.clamp((i.Position.Y - sat.AbsolutePosition.Y) / sat.AbsoluteSize.Y, 0, 1)
            apply()
        elseif draggingHue then
            h = math.clamp((i.Position.Y - hueBar.AbsolutePosition.Y) / hueBar.AbsoluteSize.Y, 0, 1)
            apply()
        end
    end)
    Connect(blocker.MouseButton1Click, function() gui:Destroy(); self.PickerGui = nil end)
end

-- ═══════════════════════════════════════════════════════════
-- KEYBIND  (cog on a toggle, or a standalone AddKeybind)
-- ═══════════════════════════════════════════════════════════
local KEY_SHORT = {
    [Enum.KeyCode.LeftShift] = "LShift", [Enum.KeyCode.RightShift] = "RShift", [Enum.KeyCode.LeftControl] = "LCtrl",
    [Enum.KeyCode.RightControl] = "RCtrl", [Enum.KeyCode.LeftAlt] = "LAlt", [Enum.UserInputType.MouseButton1] = "MB1",
    [Enum.UserInputType.MouseButton2] = "MB2", [Enum.UserInputType.MouseButton3] = "MB3",
}
local function KeyName(input)
    if KEY_SHORT[input] then return KEY_SHORT[input] end
    if typeof(input) == "EnumItem" then return input.Name end
    return "None"
end

function Library:BindKeybind(parentToggle, Options)
    Options = Options or {}
    local cog = Create("ImageButton", { AnchorPoint = Vector2.new(1, 0.5), Position = UDim2.fromScale(1, 0.5), Size = UDim2.fromOffset(16, 16), BackgroundTransparency = 1, Image = Icon("settings"), Theme = { ImageColor3 = "SubText" }, Parent = parentToggle.Box })
    local Key = { Value = Options.Default, Mode = Options.Mode or "Toggle", Type = "Keybind", Callbacks = {} }

    local pill = Create("TextButton", { AnchorPoint = Vector2.new(1, 0.5), Position = UDim2.fromScale(1, 0.5), Size = UDim2.fromOffset(44, 18), AutoButtonColor = false, Text = KeyName(Key.Value), FontFace = FONT.Medium, TextSize = 11, Theme = { BackgroundColor3 = "Element", TextColor3 = "SubText" }, Parent = parentToggle.Box })
    Corner(pill, 4)
    pill.Visible = Key.Value ~= nil
    cog.Position = UDim2.fromScale(1, 0.5)

    local listening = false
    Connect(cog.MouseButton1Click, function()
        listening = true; pill.Visible = true; pill.Text = "..."; Library.Binding = true
    end)
    Connect(pill.MouseButton1Click, function() listening = true; pill.Text = "..."; Library.Binding = true end)
    Connect(UserInputService.InputBegan, function(input, gpe)
        if listening then
            local v = input.KeyCode ~= Enum.KeyCode.Unknown and input.KeyCode or input.UserInputType
            if input.KeyCode == Enum.KeyCode.Escape or input.KeyCode == Enum.KeyCode.Backspace then v = nil end
            Key.Value = v
            pill.Text = KeyName(v)
            pill.Visible = v ~= nil
            listening = false
            task.defer(function() Library.Binding = false end)
            return
        end
        if gpe or not Key.Value then return end
        local match = (input.KeyCode == Key.Value) or (input.UserInputType == Key.Value)
        if match then
            if Key.Mode == "Toggle" then parentToggle:SetValue(not parentToggle.Value)
            elseif Key.Mode == "Hold" then parentToggle:SetValue(true) end
            if Options.Callback then pcall(Options.Callback) end
        end
    end)
    Connect(UserInputService.InputEnded, function(input)
        if Key.Mode == "Hold" and Key.Value and (input.KeyCode == Key.Value or input.UserInputType == Key.Value) then parentToggle:SetValue(false) end
    end)
    function Key:SetValue(v) self.Value = v; pill.Text = KeyName(v); pill.Visible = v ~= nil end
    parentToggle.KeyPicker = Key
    return Key
end
-- Ethos name for the above, when called on a toggle object
function Library:AddKeyPicker(toggle, opts) return self:BindKeybind(toggle, opts) end

-- ═══════════════════════════════════════════════════════════
-- NOTIFICATIONS
-- ═══════════════════════════════════════════════════════════
function Library:Notify(Options)
    if type(Options) == "string" then Options = { Title = "Zero Hub", Description = Options } end
    if not self.NotifyGui then
        self.NotifyGui = Create("ScreenGui", { Name = HttpService:GenerateGUID(false), IgnoreGuiInset = true, DisplayOrder = 99997, ResetOnSpawn = false, Parent = GuiParent() })
        self.NotifyHolder = Create("Frame", { AnchorPoint = Vector2.new(1, 1), Position = UDim2.new(1, -16, 1, -16), Size = UDim2.new(0, 280, 1, -32), BackgroundTransparency = 1, Parent = self.NotifyGui })
        List(self.NotifyHolder, 8, Enum.FillDirection.Vertical, Enum.HorizontalAlignment.Right, Enum.VerticalAlignment.Bottom)
    end
    local card = Create("Frame", { Size = UDim2.new(1, 0, 0, 0), AutomaticSize = Enum.AutomaticSize.Y, BackgroundTransparency = 1, Parent = self.NotifyHolder })
    local body = Create("CanvasGroup", { Size = UDim2.new(1, 0, 0, 0), AutomaticSize = Enum.AutomaticSize.Y, GroupTransparency = 1, Position = UDim2.fromOffset(30, 0), Theme = { BackgroundColor3 = "Panel" }, Parent = card })
    Corner(body, 8)
    Create("UIStroke", { Thickness = 1, Transparency = 0.5, Theme = { Color = "Divider" }, Parent = body })
    Create("Frame", { Size = UDim2.new(0, 3, 1, 0), BorderSizePixel = 0, Theme = { BackgroundColor3 = "Accent" }, Parent = body })
    local pad = Create("Frame", { Size = UDim2.new(1, 0, 0, 0), AutomaticSize = Enum.AutomaticSize.Y, BackgroundTransparency = 1, Parent = body })
    Pad(pad, 14, 12, 10, 10)
    List(pad, 2)
    Label({ Size = UDim2.new(1, 0, 0, 16), Text = Options.Title or "Zero Hub", FontFace = FONT.SemiBold, TextSize = 13, Theme = { TextColor3 = "TextBright" }, Parent = pad })
    if Options.Description then Label({ Size = UDim2.new(1, 0, 0, 0), AutomaticSize = Enum.AutomaticSize.Y, Text = Options.Description, FontFace = FONT.Regular, TextSize = 12, TextWrapped = true, Theme = { TextColor3 = "SubText" }, Parent = pad }) end

    Tween(body, { GroupTransparency = 0, Position = UDim2.fromOffset(0, 0) }, 0.3)
    task.delay(Options.Time or 4, function()
        Tween(body, { GroupTransparency = 1, Position = UDim2.fromOffset(30, 0) }, 0.3)
        task.delay(0.3, function() card:Destroy() end)
    end)
end


-- GROUPBOX  (BigFroot card: icon + title, chevron, thin divider, stacked controls)
-- ═══════════════════════════════════════════════════════════
local Groupbox = {}
Groupbox.__index = Groupbox

local GROUP_ICONS = {
    ["movement"] = "move", ["black marketer"] = "store", ["auto trade"] = "coins", ["status"] = "clock",
    ["stats"] = "bar-chart", ["account"] = "key", ["quick actions"] = "zap", ["theme"] = "palette",
    ["configs"] = "folder", ["menu"] = "sliders", ["webhook"] = "bell", ["webhook events"] = "bell",
    ["juzo"] = "crown", ["juzo fight"] = "sword", ["mob farm"] = "swords",
}
local function GroupIcon(name) return GROUP_ICONS[(name or ""):lower()] or "layout-dashboard" end

local function ReadCollapse()
    local data = SafeFile(readfile, Library.CollapseFile)
    if not data then return {} end
    local ok, t = pcall(HttpService.JSONDecode, HttpService, data)
    return ok and t or {}
end
local function SaveCollapse(state)
    pcall(writefile, Library.CollapseFile, HttpService:JSONEncode(state))
end

function Tab:AddGroupbox(Name, iconOverride)
    local column = self:NextColumn()
    local G = setmetatable({ Window = self.Window, Tab = self, Name = Name, Entries = {}, Collapsed = false }, Groupbox)
    self.GroupCount += 1
    table.insert(self.Groupboxes, G)

    G.Card = Create("Frame", { Size = UDim2.new(1, 0, 0, 0), AutomaticSize = Enum.AutomaticSize.Y, LayoutOrder = self.GroupCount, Theme = { BackgroundColor3 = "Panel" }, Parent = column })
    Corner(G.Card, 8)
    Create("UIStroke", { Thickness = 1, Transparency = 0.75, Theme = { Color = "Divider" }, Parent = G.Card })

    local head = Create("TextButton", { Size = UDim2.new(1, 0, 0, 38), BackgroundTransparency = 1, AutoButtonColor = false, Text = "", Parent = G.Card })
    Create("ImageLabel", { Position = UDim2.fromOffset(14, 11), Size = UDim2.fromOffset(16, 16), BackgroundTransparency = 1, Image = Icon(iconOverride or GroupIcon(Name)), Theme = { ImageColor3 = "Accent" }, Parent = head })
    Label({ Position = UDim2.fromOffset(38, 0), Size = UDim2.new(1, -70, 1, 0), Text = Name, FontFace = FONT.SemiBold, TextSize = 14, Theme = { TextColor3 = "TextBright" }, Parent = head })
    local chevron = Create("ImageLabel", { AnchorPoint = Vector2.new(1, 0.5), Position = UDim2.new(1, -12, 0.5, 0), Size = UDim2.fromOffset(16, 16), BackgroundTransparency = 1, Image = Icon("chevron-down"), Theme = { ImageColor3 = "SubText" }, Parent = head })

    Create("Frame", { Position = UDim2.fromOffset(12, 37), Size = UDim2.new(1, -24, 0, 1), BorderSizePixel = 0, Theme = { BackgroundColor3 = "Divider" }, Parent = G.Card })

    G.Body = Create("Frame", { Position = UDim2.fromOffset(0, 38), Size = UDim2.new(1, 0, 0, 0), AutomaticSize = Enum.AutomaticSize.Y, BackgroundTransparency = 1, ClipsDescendants = true, Parent = G.Card })
    G.List = List(G.Body, 10)
    Pad(G.Body, 14, 14, 10, 14)

    local function setCollapsed(state, instant)
        G.Collapsed = state
        G.Body.Visible = not state
        Tween(chevron, { Rotation = state and -90 or 0 }, instant and 0 or 0.18)
        local file = ReadCollapse()
        file[self.Name .. "::" .. Name] = state or nil
        SaveCollapse(file)
    end
    Connect(head.MouseButton1Click, function() setCollapsed(not G.Collapsed) end)

    local saved = ReadCollapse()[self.Name .. "::" .. Name]
    if saved ~= nil then setCollapsed(saved, true) elseif Library.CollapseDefault then setCollapsed(true, true) end

    function G:Register(holder, text)
        table.insert(self.Entries, { Holder = holder, Text = text })
    end
    return G
end

-- shared: label + description block at the top of a control holder
local function EntryHolder(G, height)
    local holder = Create("Frame", { Size = UDim2.new(1, 0, 0, height), BackgroundTransparency = 1, Parent = G.Body })
    return holder
end

local function AddDesc(holder, text, yStart)
    if not text or text == "" then return yStart end
    local lbl = Label({ Position = UDim2.fromOffset(0, yStart), Size = UDim2.new(1, 0, 0, 0), AutomaticSize = Enum.AutomaticSize.Y, Text = text, FontFace = FONT.Regular, TextSize = 12, TextWrapped = true, Theme = { TextColor3 = "SubText" }, Parent = holder })
    return lbl
end


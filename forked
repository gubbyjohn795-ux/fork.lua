-- TABLE  (Status / Stats cards, like BigFroot's Home page)
-- ═══════════════════════════════════════════════════════════
function Groupbox:AddTable(TitleText, Options)
    Options = Options or {}
    local rows = Options.Rows or {}
    local holder = Create("Frame", { Size = UDim2.new(1, 0, 0, 0), AutomaticSize = Enum.AutomaticSize.Y, BackgroundTransparency = 1, Parent = self.Body })
    local grid = Create("Frame", { Size = UDim2.new(1, 0, 0, 0), AutomaticSize = Enum.AutomaticSize.Y, BackgroundTransparency = 1, Parent = holder })
    Create("UIGridLayout", { CellSize = UDim2.new(1 / (Options.Columns or 3), -6, 0, 48), CellPadding = UDim2.fromOffset(6, 6), SortOrder = Enum.SortOrder.LayoutOrder, Parent = grid })

    local T = { Cells = {}, Type = "Table" }
    local function cell(value, label)
        local c = Create("Frame", { Theme = { BackgroundColor3 = "Element" }, Parent = grid })
        Corner(c, 6)
        local vl = Label({ Position = UDim2.fromOffset(10, 8), Size = UDim2.new(1, -20, 0, 18), Text = tostring(value), FontFace = FONT.Bold, TextSize = 15, Theme = { TextColor3 = "TextBright" }, Parent = c })
        Label({ Position = UDim2.fromOffset(10, 28), Size = UDim2.new(1, -20, 0, 14), Text = tostring(label), FontFace = FONT.Regular, TextSize = 11, Theme = { TextColor3 = "SubText" }, Parent = c })
        return vl
    end
    for _, r in rows do T.Cells[r[2] or r[1]] = cell(r[1], r[2]) end
    function T:Set(label, value) if self.Cells[label] then self.Cells[label].Text = tostring(value) end end
    self:Register(holder, TitleText)
    return T
end


    Label({ Position = UDim2.fromOffset(52, 21), Size = UDim2.new(1, -60, 0, 16), Text = MaskName(LocalPlayer.Name), FontFace = FONT.SemiBold, TextSize = 13, TextTruncate = Enum.TextTruncate.AtEnd, Parent = card })

    -- ── top bar: breadcrumb and search ──
    W.Top = Create("Frame", { Position = UDim2.fromOffset(SIDEBAR, 0), Size = UDim2.new(1, -SIDEBAR, 0, TOPBAR), BackgroundTransparency = 1, Parent = W.Main })
    W.Crumb = Label({ Position = UDim2.fromOffset(14, 0), Size = UDim2.new(1, -160, 1, 0), RichText = true, Text = "", FontFace = FONT.Bold, TextSize = 14, Theme = { TextColor3 = "TextBright" }, Parent = W.Top })

    local search = Create("Frame", { AnchorPoint = Vector2.new(1, 0.5), Position = UDim2.new(1, -12, 0.5, 0), Size = UDim2.fromOffset(120, 26), Theme = { BackgroundColor3 = "Field" }, Parent = W.Top })
    Corner(search, 6)
    Create("ImageLabel", { Position = UDim2.fromOffset(8, 6), Size = UDim2.fromOffset(14, 14), BackgroundTransparency = 1, Image = Icon("search"), Theme = { ImageColor3 = "SubText" }, Parent = search })
    W.SearchBox = Create("TextBox", {
        Position = UDim2.fromOffset(27, 0), Size = UDim2.new(1, -32, 1, 0), BackgroundTransparency = 1, Text = "", PlaceholderText = "search...",
        FontFace = FONT.Regular, TextSize = 12, TextXAlignment = Enum.TextXAlignment.Left, ClearTextOnFocus = false,
        Theme = { TextColor3 = "Text", PlaceholderColor3 = "SubText" }, Parent = search,
    })

    -- ── pages ──
    W.Content = Create("Frame", { Position = UDim2.fromOffset(SIDEBAR, TOPBAR), Size = UDim2.new(1, -SIDEBAR, 1, -TOPBAR), BackgroundTransparency = 1, ClipsDescendants = true, Parent = W.Main })

    -- ── resize grip, bottom right ──
    local grip = Create("TextButton", { AnchorPoint = Vector2.new(1, 1), Position = UDim2.new(1, -3, 1, -3), Size = UDim2.fromOffset(14, 14), BackgroundTransparency = 1, Text = "", ZIndex = 20, Parent = W.Main })
    for i, len in { 8, 4 } do
        Create("Frame", { AnchorPoint = Vector2.new(0.5, 0.5), Position = UDim2.fromOffset(10 - i * 2, 10 - i * 2), Size = UDim2.fromOffset(len, 1), Rotation = -45, BorderSizePixel = 0, Theme = { BackgroundColor3 = "SubText" }, BackgroundTransparency = 0.4, Parent = grip })
    end

    -- ── dragging (fades a little while you hold it, like Ethos) and resizing ──
    local dragging, resizing, start, startPos, startSize
    local function beginDrag(input)
        if input.UserInputType ~= Enum.UserInputType.MouseButton1 and input.UserInputType ~= Enum.UserInputType.Touch then return end
        dragging, start, startPos = true, input.Position, W.Main.Position
        Tween(W.Main, { GroupTransparency = 0.12 }, 0.15)
    end
    Connect(W.Top.InputBegan, beginDrag)
    local dragZone = Create("TextButton", { Size = UDim2.new(1, 0, 0, 58), BackgroundTransparency = 1, Text = "", Parent = W.Sidebar })
    Connect(dragZone.InputBegan, beginDrag)
    Connect(grip.InputBegan, function(input)
        if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
            resizing, start, startSize = true, input.Position, W.Main.AbsoluteSize
        end
    end)
    Connect(UserInputService.InputChanged, function(input)
        if input.UserInputType ~= Enum.UserInputType.MouseMovement and input.UserInputType ~= Enum.UserInputType.Touch then return end
        local d = input.Position - (start or input.Position)
        if dragging then
            W.Main.Position = UDim2.new(startPos.X.Scale, startPos.X.Offset + d.X, startPos.Y.Scale, startPos.Y.Offset + d.Y)
        elseif resizing then
            W.Main.Size = UDim2.fromOffset(math.max(620, startSize.X + d.X), math.max(420, startSize.Y + d.Y))
        end
    end)
    Connect(UserInputService.InputEnded, function(input)
        if input.UserInputType ~= Enum.UserInputType.MouseButton1 and input.UserInputType ~= Enum.UserInputType.Touch then return end
        if dragging then Tween(W.Main, { GroupTransparency = 0 }, 0.15) end
        dragging, resizing = false, false
    end)

    -- ── show / hide: slides off the bottom of the screen and fades, comes back the same way ──
    function W:SetVisible(state)
        if self.Visible == state and self.Main.Visible == state then return end
        self.Visible = state
        local home = self.HomePos or self.Main.Position
        if state then
            self.Main.Visible, self.Shadow.Visible, self.Glow.Visible = true, true, true
            self.Main.Position = UDim2.new(home.X.Scale, home.X.Offset, 1, self.Main.AbsoluteSize.Y)
            Tween(self.Main, { Position = home, GroupTransparency = 0 }, 0.45, Enum.EasingStyle.Quint)
            Tween(self.Shadow, { ImageTransparency = 0.45 }, 0.45)
            Tween(self.Glow, { ImageTransparency = Library.Glow.Window and 0.25 or 1 }, 0.45)
        else
            self.HomePos = self.Main.Position
            Tween(self.Main, { Position = UDim2.new(home.X.Scale, home.X.Offset, 1, self.Main.AbsoluteSize.Y), GroupTransparency = 1 }, 0.4, Enum.EasingStyle.Quint, Enum.EasingDirection.In)
            Tween(self.Shadow, { ImageTransparency = 1 }, 0.3)
            Tween(self.Glow, { ImageTransparency = 1 }, 0.3)
            task.delay(0.4, function()
                if not self.Visible then self.Main.Visible, self.Shadow.Visible, self.Glow.Visible = false, false, false end
            end)
            Library:ClosePopup()
        end
    end
    function W:ToggleVisible() self:SetVisible(not self.Visible) end

    Connect(UserInputService.InputBegan, function(input, gpe)
        if gpe or Library.Binding then return end
        if input.KeyCode == Library.ToggleKey then W:ToggleVisible() end
    end)

    function W:SetMinimized(state)
        self.Minimized = state
        if state then
            self.FullSize = self.Main.Size
            Tween(self.Main, { Size = UDim2.fromOffset(self.Main.AbsoluteSize.X, TOPBAR) }, 0.25)
        else
            Tween(self.Main, { Size = self.FullSize or size }, 0.25)
        end
    end

    function W:SetExecutions(count)
        self.Executions = count
        self.VersionLabel.Text = (Config.Version or "") .. (count and ("  ·  " .. count .. " runs") or "")
    end

    function W:Unload()
        Library.Unloaded = true
        for _, c in Library.Connections do pcall(function() c:Disconnect() end) end
        table.clear(Library.Connections)
        for _, fn in Library.UnloadCallbacks or {} do pcall(fn) end
        pcall(function() self.Gui:Destroy() end)
        pcall(function() if Library.NotifyGui then Library.NotifyGui:Destroy() end end)
        if getgenv()._ZeroWindow == self then getgenv()._ZeroWindow = nil end
    end

    getgenv()._ZeroWindow = W
    Library.Window = W

    -- in from below on load
    task.defer(function()
        W.HomePos = W.Main.Position
        W.Visible = false
        W:SetVisible(true)
    end)
    return W
end

function Library:OnUnload(fn)
    self.UnloadCallbacks = self.UnloadCallbacks or {}
    table.insert(self.UnloadCallbacks, fn)
end
function Library:Unload() if self.Window then self.Window:Unload() end end


